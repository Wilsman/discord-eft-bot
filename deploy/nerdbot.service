[Unit]
Description=NerdBot Discord bot
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/nerdbot/app/.env

[Service]
User=nerdbot
WorkingDirectory=/opt/nerdbot/app
ExecStart=/opt/nerdbot/venv/bin/python -m nerdbot
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10
MemoryMax=400M

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/nerdbot/app

[Install]
WantedBy=multi-user.target
